#!/bin/sh

export PLAYWRIGHT_BROWSERS_PATH="$SNAP/usr/share/ms-playwright"

. "$SNAP/bin/openclaw-sanitize-env"
sanitize_openclaw_snap_env

mkdir -p "$HOME/workspace"

# Extract --model <name> early; used below to select a specific recipe with
# --auto.  All other args are passed through to the Node setup script.
MODEL=""
_prev=""
for arg in "$@"; do
  [ "$_prev" = "--model" ] && { MODEL="$arg"; _prev=""; continue; }
  case "$arg" in
    --model=*) MODEL="${arg#--model=}" ;;
    --model)   _prev="--model" ;;
  esac
  _prev="$arg"
done

# Install (or refresh) the systemd user service unit when --auto is passed,
# so the service is ready even before the main openclaw launcher has run.
for arg in "$@"; do
  if [ "$arg" = "--auto" ]; then
    SERVICE_NAME="openclaw-gateway"
    unit_src="$SNAP/share/systemd/user/${SERVICE_NAME}.service"
    unit_dir="$HOME/.config/systemd/user"
    unit_dst="$unit_dir/${SERVICE_NAME}.service"
    LEGACY_UNIT="$unit_dir/openclaw.service"
    if [ -f "$unit_src" ]; then
      mkdir -p "$unit_dir"
      if [ ! -f "$unit_dst" ] || ! cmp -s "$unit_src" "$unit_dst"; then
        cp "$unit_src" "$unit_dst"
      fi
      if [ -f "$LEGACY_UNIT" ] && grep -q '/snap/bin/openclaw.daemon' "$LEGACY_UNIT"; then
        systemctl --user disable --now openclaw >/dev/null 2>&1 || true
        rm -f "$LEGACY_UNIT"
      fi
      systemctl --user daemon-reload 2>/dev/null || true
      if ! systemctl --user is-enabled "$SERVICE_NAME" >/dev/null 2>&1; then
        systemctl --user enable --now "$SERVICE_NAME" 2>/dev/null || true
      fi
    fi
    break
  fi
done

# --auto maps to 'configure' (non-interactive best-model selection).
# When --model <name> is provided, pass it as --recipe so setup-providers.js
# selects that exact model rather than using its own preference heuristic.
# Interactive invocations use 'onboard --force' which presents the TUI.
for arg in "$@"; do
  if [ "$arg" = "--auto" ]; then
    if [ -n "$MODEL" ]; then
      "$SNAP/bin/node" "$SNAP/bin/setup-providers.js" configure --recipe "$MODEL"
    else
      "$SNAP/bin/node" "$SNAP/bin/setup-providers.js" configure
    fi
    status=$?
    if [ "$status" -eq 0 ]; then
      systemctl --user restart openclaw-gateway >/dev/null 2>&1 || true
    fi
    exit "$status"
  fi
done

"$SNAP/bin/node" "$SNAP/bin/setup-providers.js" onboard --force "$@"
status=$?

if [ "$status" -eq 0 ]; then
  systemctl --user restart openclaw-gateway >/dev/null 2>&1 || true
fi

exit "$status"

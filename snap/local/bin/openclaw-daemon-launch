#!/bin/sh
# openclaw-daemon-launch — persistent gateway service.
#
export PLAYWRIGHT_BROWSERS_PATH="$SNAP/usr/share/ms-playwright"

. "$SNAP/bin/openclaw-sanitize-env"
sanitize_openclaw_snap_env

mkdir -p "$HOME/workspace"

OPENCLAW_MJS=$(find "$SNAP/lib/node_modules" \
  -name "openclaw.mjs" -path "*/openclaw/openclaw.mjs" | head -1)

if [ -z "$OPENCLAW_MJS" ]; then
  echo "openclaw: cannot locate openclaw.mjs under $SNAP/lib/node_modules" >&2
  exit 1
fi

CONFIG_FILE="$HOME/.openclaw/openclaw.json"

if [ ! -f "$CONFIG_FILE" ]; then
  # Bootstrap device identity, credential store, and gateway token so the
  # CLI can connect immediately without a separate 'openclaw setup' step.
  "$SNAP/bin/node" "$OPENCLAW_MJS" setup --non-interactive --accept-risk --mode local 2>&1 || true
fi

# --allow-unconfigured lets the gateway start before the user has completed
# first-run onboarding or selected an LLM provider.
if [ "$1" = "gateway" ]; then
  shift
fi

exec "$SNAP/bin/node" "$OPENCLAW_MJS" gateway --allow-unconfigured "$@"
